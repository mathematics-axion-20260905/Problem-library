# Copy to backend/.env on the server. Keep the real file out of git.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,169.58.123.200
DJANGO_CORS_ALLOWED_ORIGINS=http://169.58.123.200:3014,http://169.58.123.200:3015,http://169.58.123.200:3016,http://169.58.123.200:3017
DJANGO_CSRF_TRUSTED_ORIGINS=http://169.58.123.200:3014,http://169.58.123.200:3015,http://169.58.123.200:3016,http://169.58.123.200:3017
DJANGO_SECURE_SSL_REDIRECT=false
MEDIA_ROOT=/absolute/path/to/problem-library/backend/media

# SQLite is suitable for local development only. Use PostgreSQL for a
# multi-instance deployment or any sustained write volume.
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=/absolute/path/to/db.sqlite3

# PostgreSQL example:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=axion_core
# DB_USER=axion_core
# DB_PASSWORD=replace-with-a-secret
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_CONN_MAX_AGE=60
